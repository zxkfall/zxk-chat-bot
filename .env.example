# 允许使用机器人的微信用户 ID（逗号分隔）。默认拒绝一切，务必填写。
ALLOW_FROM=

# opencode 工作目录：机器人所有文件操作/命令都在此目录执行
OPENCODE_CWD=

# 可用项目列表（逗号分隔，绝对路径）。微信里用 /projects 查看、/project <编号> 切换
PROJECTS=

# 自动允许 opencode 的工具权限请求（bash/edit 等），否则 headless 下会挂起等待。默认 true
AUTO_APPROVE_PERMISSIONS=true

# opencode server 端口（默认 4096）
OPENCODE_PORT=4096

# 默认 agent: build | plan
DEFAULT_AGENT=build

# 微信 bot 显示名（可选）
BOT_NAME=ZXK Bot

# 微信 iLink 凭据存储目录（扫码后自动保存，无需手动配置）
WECHAT_STORAGE_DIR=./data/wechat

# 本地通知 hook（wechat_notify 工具把消息从 opencode 送回微信）
HOOK_PORT=19890
# 不填则每次启动随机生成，经环境变量传给 opencode serve
HOOK_TOKEN=

# 日志：debug | info | warn | error，按天写入 data/logs/bot-YYYYMMDD.log
LOG_LEVEL=info
LOG_DIR=data/logs
